{
  "name": "subscript",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "prettier": "3.9.6",
    "turbo": "^2.10.11",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.18.0"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
