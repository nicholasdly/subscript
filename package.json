{
  "name": "subscript",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "changeset": "turbo run build typecheck lint format test && changeset",
    "changeset:version": "turbo run build typecheck lint format test && changeset version",
    "changeset:publish": "turbo run build typecheck lint format test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "prettier": "3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
