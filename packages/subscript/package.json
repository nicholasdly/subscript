{
  "name": "@repo/subscript",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./internals": {
      "types": "./src/internals.ts",
      "default": "./dist/internals.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "tsc",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/node": "^24",
    "turbo": "^2.10.11",
    "typescript": "7.0.2"
  }
}
