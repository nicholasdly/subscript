{
  "name": "@nicholasdly/subscript",
  "version": "1.1.0",
  "description": "Natural-language evaluation of arithmetic, unit conversion, and time zones.",
  "keywords": [
    "arithmetic",
    "conversion",
    "evaluate",
    "math",
    "natural-language",
    "timezone",
    "units"
  ],
  "homepage": "https://github.com/nicholasdly/subscript/tree/main/packages/subscript#readme",
  "bugs": {
    "url": "https://github.com/nicholasdly/subscript/issues"
  },
  "license": "MIT",
  "author": "Nicholas Ly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicholasdly/subscript.git",
    "directory": "packages/subscript"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./internals": {
      "import": {
        "types": "./dist/internals.d.ts",
        "default": "./dist/internals.js"
      },
      "require": {
        "types": "./dist/internals.d.cts",
        "default": "./dist/internals.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/node": "^24",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
